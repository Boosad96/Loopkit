                },
                "example": {
                  "error": "insufficient_scope"
                }
              }
            }
          },
          "409": {
            "description": "Scan busy or disabled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "status": "busy"
                }
              }
