{
  "openapi": "3.1.0",
  "info": {
    "title": "LoopKit Growth API for Meta Muse",
    "version": "1.0.0",
    "description": "Private API. Up to 60 requests per minute per Cloudflare location and IP, 600 daily per credential, 1,200 daily across credentials, and eight manual scans daily shared by API and dashboard. Approvals record review decisions."
  },
  "servers": [
    {
      "url": "https://growth.loopkit.site"
    }
  ],
  "security": [
    {
      "MetaMuseToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "MetaMuseToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "id.secret"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Opportunity": {
        "type": "object",
        "required": [
          "id",
          "source",
          "original_url",
          "title",
          "problem",
          "tool_slug",
          "tool",
          "score",
          "draft",
          "published_at",
          "discovered_at",
          "high_intent",
          "status",
          "reviewed_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "original_url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "tool_slug": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "draft": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "discovered_at": {
            "type": "string",
            "format": "date-time"
          },
          "high_intent": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "approved",
              "dismissed",
              "archived"
            ]
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/api/growth/status": {
      "get": {
        "summary": "Read automation and source status",
        "x-required-scope": "read",
        "responses": {
          "200": {
            "description": "Automation status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "automation_enabled": true,
                  "interval_minutes": 15,
                  "running": false,
                  "launched_at": null,
                  "launch_mode": false,
                  "last_successful_scan": null,
                  "last_scan": null,
                  "counts": {
                    "total": 0,
                    "pending": 0,
                    "high_intent": 0
                  },
                  "manual_scans": {
                    "used": 0,
                    "limit": 8
                  },
                  "sources": []
                }
              }
            }
          },
          "401": {
            "description": "invalid_credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_credentials"
                }
              }
            }
          },
          "403": {
            "description": "insufficient_scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "insufficient_scope"
                }
              }
            }
          },
          "429": {
            "description": "rate_limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limit"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "service_unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/growth/opportunities": {
      "get": {
        "summary": "List opportunities",
        "x-required-scope": "read",
        "responses": {
          "200": {
            "description": "Opportunity page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Opportunity"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "example": {
                  "items": [],
                  "next_cursor": null
                }
              }
            }
          },
          "400": {
            "description": "invalid_filter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_filter"
                }
              }
            }
          },
          "401": {
            "description": "invalid_credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_credentials"
                }
              }
            }
          },
          "403": {
            "description": "insufficient_scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "insufficient_scope"
                }
              }
            }
          },
          "429": {
            "description": "rate_limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limit"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "service_unavailable"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "new",
                "approved",
                "dismissed",
                "archived"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{13}:[a-f0-9]{24}$"
            }
          }
        ]
      }
    },
