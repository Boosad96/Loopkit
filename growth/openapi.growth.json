    "/api/growth/scan": {
      "post": {
        "summary": "Queue one discovery batch and return its identifier",
        "x-required-scope": "scan",
        "responses": {
          "202": {
            "description": "Scan queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "status": "started",
                  "scan_id": "a942a2a2-c545-4ae8-8f26-fce04d05b5ca"
                }
              }
            }
          },
          "401": {
            "description": "invalid_credentials",
